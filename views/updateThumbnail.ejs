<%- include('partials/header_backoff.ejs') %>
<br><br><br><br>
      
        <div class="container d-flex justify-content-center align-items-center">

            <form id="updateFormThumb" action="/admin/thumbnailUpdated" method="POST">    
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">        
                <div class="input-group mb-3">
                    <span class="input-group-text" id="title_thumbnail"><b>Titre du projet</b></span>
                    <input 
                        type="text" 
                        class="form-control" 
                        id="title_thumbnail" 
                        name="title_thumbnail" 
                        aria-label="Sizing example input" 
                        aria-describedby="inputGroup-sizing-default"
                        value="<%= thumbnail.title %>"
                        >
                </div>
                <br>
                <!-- CATEGORY -->
                <select class="form-select mb-3" id="category" name="category" aria-label="Default select example">
                    <option selected><%= thumbnail.category %></option>
                    <option value="animation">Animation</option>
                    <option value="liveaction">Live Action</option>
                  </select>
                <div>
                <br>
                <!-- IMAGE --> 
                <div class="input-group mb-3">
                    <label class="input-group-text" for="img_thumbnail"><b>Thumbnail - Image</b></label>
                    <input 
                        type="text" 
                        class="form-control" 
                        id="img_thumbnail" 
                        name="img_thumbnail"
                        value="<%= thumbnail.imgSrc %>"
                        required >
                    <br>
                </div>   
                <!-- IMG_THUMBNAIL : direct upload to S3, fills the field above -->
                <div class="s3-upload mb-3">
                    <label class="text-white" for="img_thumbnail_file">Importer l'image (JPG) — le lien ci-dessus se remplit automatiquement :</label>
                    <input 
                        type="file" 
                        class="form-control" 
                        id="img_thumbnail_file" 
                        accept="image/jpeg,.jpg,.jpeg"
                        data-s3-upload 
                        data-folder="thumbnails" 
                        data-target="img_thumbnail">
                </div>
                <br>
                <!-- VIDEO --> 
                <div class="input-group mb-3">
                    <label class="input-group-text" for="vid_thumbnail"><b>Thumbnail - Vidéo</b></label>
                    <input 
                        type="text" 
                        class="form-control" 
                        id="vid_thumbnail" 
                        name="vid_thumbnail"
                        value="<%= thumbnail.videoSrc %>"
                        required >
                    <br>
                </div>
                <!-- VID_THUMBNAIL : direct upload to S3, fills the field above -->
                <div class="s3-upload mb-3">
                    <label class="text-white" for="vid_thumbnail_file">Importer la vidéo (MP4) — le lien ci-dessus se remplit automatiquement :</label>
                    <input 
                        type="file" 
                        class="form-control" 
                        id="vid_thumbnail_file" 
                        accept="video/mp4,.mp4"
                        data-s3-upload 
                        data-folder="thumbnails" 
                        data-target="vid_thumbnail">
                </div>
                <br><br>
                <!-- SEND -->
                <div class="d-flex justify-content-center align-items-center">
                    <input type="hidden" name="identifier" value="<%= thumbnail._id %>">
                    <input type="submit" class="btn btn-outline-light btn-lg"  value="Update">
                </div>
            </form>
            
        </div>
        <script src="/public/js/s3-upload.js?v=2" defer></script>
    </body>
</html>

