<%- include('partials/header_backoff.ejs') %>

        <div class="container">
            <h2 class="mt-5 mb-4">Hello <%= username %> </h2>

            <%- include('partials/messages.ejs') %>

            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col"><h5>Projects</h5></th>
                        <th scope="col">Modifier</th>
                        <th scope="col">Supprimer</th>
                    </tr>
                </thead>
                <tbody>
                    <% projectsList.forEach(project => {%>
                    <tr>
                        <td scope="row"><%= project.project_title %></td>
                        <td><a class="btn btn-light" href="/admin/updateProject/<%= project._id %>">Update</a></td>
                        <td>
                            <form method="POST" action="/admin/deleteProject/<%= project._id %>"
                                  data-confirm="Supprimer le projet « <%= project.project_title %> » du site (définitif) ?&#10;&#10;Sa page, son thumbnail et tous leurs fichiers seront supprimés.&#10;Pour corriger le projet, utilisez plutôt « Update ».">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <%})%>
                </tbody>
            </table>

            <br><br>

            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col"><h5>Thumbnails</h5></th>
                        <th scope="col">Page projet</th>
                        <th scope="col">Modifier</th>
                        <th scope="col">Supprimer</th>
                    </tr>
                </thead>
                <tbody>
                    <% thumbnailsList.forEach(thumbnail => {
                        const projectTitle = projectTitleByThumbnail[String(thumbnail._id)]; %>
                    <tr>
                        <td scope="row"><%= thumbnail.title %></td>
                        <td>
                            <% if (projectTitle) { %>
                                <%= projectTitle %>
                            <% } else { %>
                                <a class="text-warning" href="/admin/uploadProject">⚠ aucune — créer la page</a>
                            <% } %>
                        </td>
                        <td><a class="btn btn-light" href="/admin/updateThumbnail/<%= thumbnail._id %>">Update</a></td>
                        <td>
                            <form method="POST" action="/admin/deleteThumbnail/<%= thumbnail._id %>"
                                  data-confirm="Supprimer <%= projectTitle ? `le projet « ${projectTitle} »` : `le thumbnail « ${thumbnail.title} »` %> du site (définitif) ?&#10;&#10;<%= projectTitle ? 'Son thumbnail, sa page projet et tous leurs fichiers seront supprimés.' : 'Le thumbnail et ses fichiers seront supprimés.' %>&#10;Pour corriger, utilisez plutôt « Update ».">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <%})%>
                </tbody>
            </table>
        </div>

        <script>
            // Deletions cannot be undone: ask for confirmation
            document.querySelectorAll('form[data-confirm]').forEach(form => {
                form.addEventListener('submit', (e) => {
                    if (!window.confirm(form.dataset.confirm)) e.preventDefault();
                });
            });
        </script>
    </body>
</html>
