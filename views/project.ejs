<%- include('partials/header.ejs') %>

<%
    // Column width for a row of n visuals (1 to 4). Mirrored in public/js/project-editor.js (preview).
    const ROW_COLS = { 1: 'col-12', 2: 'col-sm-6 col-12', 3: 'col-sm-4 col-12', 4: 'col-md-3 col-6' };
%>

<div class="container">
    <main class="project-wrapper">

        <!-- SECTION 1 - Intro -->
        <section id="section-1" class="mb-3">
            <!-- MAIN VIDEO -->
            <% if (project.main_video) { %>
                <div class="video-iframe mb-3">
                    <iframe class="resp-iframe"
                            src="<%= project.main_video %>"
                            frameborder="0" allowfullscreen
                            title="vimeo-player">
                    </iframe>
                </div>
            <% } %>

            <!-- INFOS -->
            <div class="text-center mt-3">
                <h1 class="project_title"><%= project.project_title %></h1>
                <p class="project"><%= project.director %></p>
                <p class="project"><%= project.other_contributors %></p>
                <p class="project"><%= project.productor %></p>
            </div>
        </section>

        <!-- SECTION 2 - Content blocks (built in the back office) -->
        <section id="section-2">
            <% project.blocks.forEach((block) => { %>

                <% if (block.type === 'row') { %>
                    <div class="row gy-4 gx-4 mb-4">
                        <% block.items.forEach((item) => { %>
                            <div class="<%= ROW_COLS[block.items.length] %>">
                                <% if (item.url.endsWith('.jpg')) { %>
                                    <img class="img-fluid w-100"
                                         src="<%= cdnUrl(item.url) %>"
                                         alt="<%= item.caption || `visuel pour ${project.project_title}` %>"
                                         data-action="zoom">
                                <% } else { %>
                                    <video class="img-fluid w-100" autoplay playsinline muted loop
                                           src="<%= cdnUrl(item.url) %>"></video>
                                <% } %>
                                <% if (item.caption) { %>
                                    <p class="projet-legende mt-2"><%= item.caption %></p>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>

                <% } else if (block.type === 'vimeo') { %>
                    <div class="video-iframe mb-4">
                        <iframe class="resp-iframe"
                                src="<%= block.url %>"
                                frameborder="0" allowfullscreen
                                title="vimeo-player">
                        </iframe>
                    </div>
                <% } %>

                <% if (block.text) { %>
                    <p class="text-white projet-paragraphe mb-4"><%= block.text %></p>
                <% } %>

            <% }) %>
        </section>
    </main>
</div>

<%- include('partials/footer.ejs') %>
